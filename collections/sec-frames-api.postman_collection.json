  "item": [
    {
      "id": "c63ecc2b-5b78-4144-90b9-b0b3161c711b",
      "name": "Frames",
      "description": {
        "content": "Cross-company data for a concept in a specific period",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "86bba95b-fe64-43d6-9f0d-91e49c8d9d94",
          "name": "Get cross-company data for a concept in a period",
          "request": {
            "name": "Get cross-company data for a concept in a period",
            "description": {
              "content": "Returns data for a given XBRL concept across all companies that reported it for a specific period. This enables cross-company comparisons for any financial metric. Periods can be annual (CY2023), quarterly (CY2023Q1), or instantaneous (CY2023Q1I for point-in-time balance sheet concepts). The response includes each company's CIK, entity name, accession number, location reference, and reported value.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "xbrl",
                "frames",
                ":taxonomy",
                ":tag",
                ":unit",
                "{{period}}.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "taxonomy",
                  "description": "(Required) XBRL taxonomy. One of us-gaap, ifrs-full, dei, or srt.\n"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "tag",
                  "description": "(Required) XBRL concept tag name."
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "unit",
                  "description": "(Required) Unit of measure. Common values: USD, shares, pure, USD-per-shares.\n"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
