  "item": [
    {
      "id": "c6f2bff9-aab8-4bb8-87f8-f93ed44315dd",
      "name": "Search",
      "description": {
        "content": "Full-text search across EDGAR filing documents",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "30c3921d-e770-46d8-bafa-7eb79b693db2",
          "name": "Search EDGAR filings by full text",
          "request": {
            "name": "Search EDGAR filings by full text",
            "description": {
              "content": "Searches the full text of EDGAR filings using Elasticsearch-backed indexing. Supports keyword queries, boolean operators, phrase matching, and field-specific filters. Results include filing metadata and direct links to matching documents. Rate limited to 10 requests per second.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "LATEST",
                "search-index",
                "efts"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "Full-text search query. Supports phrase matching (\"exact phrase\"), boolean operators (AND, OR, NOT), and field-specific searches (e.g., entity_name:\"Apple Inc\"). Leave empty to browse all filings.\n"
                },
                {
                  "disabled": false,
                  "key": "dateRange",
                  "value": "<string>",
                  "description": "Date range filter. Use \"custom\" to specify startdt and enddt, or \"30d\", \"1y\", \"5y\" for relative ranges.\n"
                },
                {
                  "disabled": false,
                  "key": "startdt",
                  "value": "<date>",
                  "description": "Start date for custom date range filter (YYYY-MM-DD format). Only used when dateRange is \"custom\".\n"
                },
                {
                  "disabled": false,
                  "key": "enddt",
                  "value": "<date>",
                  "description": "End date for custom date range filter (YYYY-MM-DD format). Only used when dateRange is \"custom\".\n"
                },
                {
                  "disabled": false,
                  "key": "forms",
                  "value": "<string>",
                  "description": "Comma-separated list of form types to filter results. Example: 10-K,10-Q,8-K\n"
                },
                {
                  "disabled": false,
                  "key": "entity",
                  "value": "<string>",
                  "description": "Filter by entity name. Partial matches supported.\n"
                },
                {
                  "disabled": false,
                  "key": "ticker",
                  "value": "<string>",
                  "description": "Filter by stock ticker symbol.\n"
                },
                {
                  "disabled": false,
                  "key": "_source",
                  "value": "<string>",
                  "description": "Comma-separated list of fields to return in the response. Default returns all fields.\n"
                },
                {
                  "disabled": false,
                  "key": "from",
                  "value": "0",
                  "description": "Starting offset for pagination (zero-based).\n"
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "10",
                  "description": "Number of results to return per page. Maximum is 10 per request for full-text results.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
