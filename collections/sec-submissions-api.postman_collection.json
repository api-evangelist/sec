          "name": "Get company submissions",
          "request": {
            "name": "Get company submissions",
            "description": {
              "content": "Returns a company's complete filing history and metadata identified by Central Index Key (CIK). The response includes company name, SIC code, state of incorporation, addresses, phone number, and a list of recent filings with accession numbers, form types, filing dates, and document metadata. For companies with more than 40 filings, additional files are referenced in the response.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "submissions",
                "CIK{{cik}}.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
